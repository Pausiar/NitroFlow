{
  "name": "nitroflow",
  "version": "1.1.0",
  "description": "NitroFlow – Intelligent Windows System Optimizer",
  "main": "out/main/index.js",
  "author": "NitroFlow",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "generate:icon": "node scripts/generate-icon.mjs",
    "prepackage": "npm run generate:icon",
    "package": "electron-builder --win",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-progress": "^1.0.3",
    "@radix-ui/react-scroll-area": "^1.0.5",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-tooltip": "^1.0.7",
    "axios": "^1.6.7",
    "clsx": "^2.1.0",
    "electron-log": "^5.1.1",
    "electron-store": "^8.2.0",
    "lucide-react": "^0.344.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^2.12.2",
    "tailwind-merge": "^2.2.1",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.25",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "electron": "^29.1.1",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.0.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "postcss": "^8.4.35",
    "png-to-ico": "^2.1.8",
    "sharp": "^0.34.2",
    "tailwindcss": "^3.4.1",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.2",
    "vite": "^5.1.5"
  },
  "build": {
    "appId": "com.nitroflow.app",
    "productName": "NitroFlow",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": ["nsis"],
      "icon": "resources/icon.ico",
      "signAndEditExecutable": false,
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "files": ["out/**/*"],
    "extraResources": ["resources/**/*"]
  },
  "jest": {
    "testEnvironment": "node",
    "roots": ["<rootDir>/tests"],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": {
            "module": "CommonJS",
            "moduleResolution": "node",
            "esModuleInterop": true,
            "skipLibCheck": true,
            "strict": false,
            "resolveJsonModule": true
          }
        }
      ]
    },
    "moduleNameMapper": {
      "^electron$": "<rootDir>/tests/__mocks__/electron.ts",
      "^electron-store$": "<rootDir>/tests/__mocks__/electron-store.ts",
      "^electron-log$": "<rootDir>/tests/__mocks__/electron-log.ts"
    },
    "collectCoverageFrom": [
      "src/main/services/**/*.ts",
      "src/main/utils/**/*.ts"
    ]
  }
}
